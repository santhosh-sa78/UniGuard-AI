# UniGuard-AI Environment Configuration

# General
UNIGUARD_ENV=development
LOG_LEVEL=INFO

# Capture
CAPTURE_INTERFACE=eth0
CAPTURE_MODE=passive          # passive | replay
FLOW_TIMEOUT_SECONDS=120

# Model
MODEL_DIR=model
CYBER_THREAT_MODEL_PATH=model/cyber_threat_model.pkl
ANOMALY_MODEL_PATH=model/anomaly_model.pkl

# Detection
DETECTION_THRESHOLD=0.75
ANOMALY_THRESHOLD=0.65

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000
SECRET_KEY=change-me-in-production

# Database
DATABASE_URL=sqlite:///storage/uniguard.db

# Alerts
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_SMTP_HOST=smtp.example.com
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_FROM=alerts@uniguard.local
ALERT_EMAIL_TO=soc-team@example.com

ALERT_WEBHOOK_ENABLED=false
ALERT_WEBHOOK_URL=https://hooks.example.com/uniguard
